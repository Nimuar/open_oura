<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for API < 31. Backup is disabled app-wide
   (android:allowBackup="false"); these excludes are defence in depth so the ring
   auth key, its MAC, and synced health data never leave the device via backup.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
